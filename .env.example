# Netlify build-time analytics configuration. These values should match the
# marketing website and product deployments.
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-ZRT44MWJT1
POSTHOG_PROJECT_API_KEY=
POSTHOG_PUBLIC_HOST=https://events.zeroquarry.com
POSTHOG_UI_HOST=https://us.posthog.com

# Algolia DocSearch. The search-only key below is designed to be public (it is
# shipped to every browser), and both values already fall back to the live
# values in docusaurus.config.js, so search works without configuring these.
ALGOLIA_APP_ID=AKB66XJY2S
ALGOLIA_SEARCH_KEY=
